# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=440ca1dcce83771141fabb0091f89742e5ad1ee2f429236b9ec12586c9cffbeb
###< lexik/jwt-authentication-bundle ###
###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> app ###
# URL of the Nuxt front
FRONTEND_URL=http://localhost:4000
# First-run setup: until a user exists, /setup creates the administrator. If the instance is reachable
# by others before you set it up, set a secret here: the setup page will ask for it.
SETUP_TOKEN=

# Key encrypting the secrets stored in the database (LDAP bind password, OpenID Connect client secrets…).
# Empty: derived from APP_SECRET. Changing it makes the stored secrets unreadable: they must then be entered again.
SECRETS_ENCRYPTION_KEY=
# Clé maîtresse du coffre des secrets (rocket-core, Administration → Secrets) : jetons et clés des intégrations,
# chiffrés en base. `php bin/console rocket:secrets:generate-key`, à mettre dans .env.local (jamais committée).
# La perdre rend les secrets illisibles : la sauvegarder hors de la base.
ROCKET_SECRETS_KEY=
# Data written by the application (checked on the dashboard).
DATA_DIR=%kernel.project_dir%/var/data
# LDAP directory: default configuration. Administrators can then change it in Administration → Annuaire LDAP
# (stored in the database, password encrypted); "Revenir aux valeurs par défaut" goes back to these values.
LDAP_ENABLED=0
LDAP_URL=ldap://localhost:389
# STARTTLS on an ldap:// URL (use ldaps:// for implicit TLS).
LDAP_START_TLS=0
LDAP_BASE_DN="ou=people,dc=example,dc=org"
LDAP_SEARCH_DN="cn=admin,dc=example,dc=org"
LDAP_SEARCH_PASSWORD=
LDAP_USER_FILTER="(objectClass=inetOrgPerson)"
# Members of this group get ROLE_ADMIN; leave empty to manage admins in the app.
LDAP_ADMIN_GROUP_DN=
# Attributes read from the entries (e.g. Active Directory: userPrincipalName or mail, givenName, sn, memberOf).
LDAP_ATTRIBUTE_EMAIL=mail
LDAP_ATTRIBUTE_FIRST_NAME=givenName
LDAP_ATTRIBUTE_LAST_NAME=sn
LDAP_ATTRIBUTE_GROUPS=memberOf
# Version of the build ("git describe --tags", set by the Docker image). Empty: "dev".
APP_VERSION=
# Updates: GitHub repository whose releases are checked (empty: no check).
UPDATE_REPOSITORY=fayouz/rocket-clean
# One-click update: HTTP API of the "updater" service (Watchtower) of compose.yaml, and its token.
UPDATER_URL=
UPDATER_TOKEN=
# Update method: docker (UPDATER_*), script (servers without Docker) or manual. Empty: docker if UPDATER_TOKEN is set,
# else manual. Administrators can change it in Administration → Mises à jour.
UPDATE_METHOD=
# Script method: run by the scheduled task `bin/console app:update:run` (every minute, as the owner of the files).
UPDATE_SCRIPT=%kernel.project_dir%/../deploy/update.sh
# Command restarting the services once updated, run by the script, e.g. "sudo systemctl restart rocket-pms-front".
UPDATE_RESTART_COMMAND=
UPDATE_SCRIPT_TIMEOUT=1800
###< app ###
###> rocket-clean ###
# Rocket Place : lieux et stock (jeton d'application rpl_…). Vide : lieux locaux (mode autonome, entité Site).
ROCKET_PLACE_URL=
# Rocket Stock (stock des lieux, relevés des ménages) : API et jeton d'application (rst_…). Vide : stock de Rocket Place, sinon aucun.
ROCKET_STOCK_URL=
# Rocket Cloud (photos des ménages, un dossier par lieu) : adresse de l'API et jeton d'application (rca_…). Vide : dossiers de démo.
ROCKET_CLOUD_URL=
# Rocket Mailer (e-mails of cleanings). Empty: demo (recorded in var/demo-mailer-<env>.json, nothing sent).
# ROCKET_MAILER_SENDER: user known to Rocket Mailer on whose behalf automatic e-mails go (default: first admin).
ROCKET_MAILER_URL=
ROCKET_MAILER_MAILBOX=
ROCKET_MAILER_SENDER=
# Jours d'avance des ménages générés par les récurrences.
CLEANING_RECURRENCE_DAYS=14
###< rocket-clean ###
# Mode suite (Rocket Auth, voir rocket-core README « Modes autonome et suite ») : vide = autonome.
# ROCKET_AUTH_URL=http://localhost:3100
# ROCKET_AUTH_INTERNAL_URL=http://auth-api
# ROCKET_AUTH_CLIENT_ID=rocket-clean
# ROCKET_AUTH_CLIENT_SECRET=
# ROCKET_AUTH_ADMIN_GROUP=rocket-admins
# ROCKET_PUBLIC_URL=http://localhost:4000
# ROCKET_INTERNAL_URL=http://clean-api
# En mode suite, les appels à Rocket Cloud et Rocket Place utilisent un jeton Rocket Auth (client credentials,
# audiences rocket-cloud / rocket-place) ; secret rocket.cloud.token / secret rocket.place.token restent le repli (mode autonome).
