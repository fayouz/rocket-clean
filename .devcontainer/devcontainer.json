{
  "name": "Rocket Clean (démo)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "forwardPorts": [4000, 4001],
  "portsAttributes": {
    "4000": { "label": "Rocket Clean", "onAutoForward": "notify" },
    "4001": { "label": "Documentation et changelog", "onAutoForward": "notify" },
    "9000": { "label": "API", "onAutoForward": "silent" },
    "5432": { "onAutoForward": "ignore" }
  },
  "postStartCommand": "bash demo/codespaces/start.sh"
}
